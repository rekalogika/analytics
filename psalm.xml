<?xml version="1.0"?>
<psalm
        errorLevel="1"
        resolveFromConfigFile="true"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
        findUnusedBaselineEntry="true"
        findUnusedCode="false">

    <projectFiles>
        <directory name="packages" />
        <directory name="tests/src" />
        <directory name="tests/config" />
        <directory name="tests/bin" />
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="tests/src/App/Factory" />
            <file name="packages/analytics-core/src/Engine/SummaryRefresher/Query/RollUpSummaryToSummaryCubingStrategyQuery.php" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <MissingConstructor>
            <errorLevel type="suppress">
                <directory name="tests/src/App/Entity" />
            </errorLevel>
        </MissingConstructor>
        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <directory name="tests/src/App/Entity" />
                <directory name="packages/analytics-core/src/Core/Entity" />
                <directory name="packages/analytics-core/src/Contracts/Exception" />
                <directory name="packages/analytics-core/src/Engine/Entity" />
                <directory name="packages/analytics-core/src/Time/Dimension" />
            </errorLevel>
        </ClassMustBeFinal>
        <!-- deprecated in DBAL 4.5, but its replacement Table::edit() creates
             a new table, and we need to modify the table in place -->
        <DeprecatedMethod>
            <errorLevel type="suppress">
                <referencedMethod name="Doctrine\DBAL\Schema\Table::addIndex" />
            </errorLevel>
        </DeprecatedMethod>
        <!-- the replacement ExpressionWithReturnType is not available in ORM 2 -->
        <DeprecatedInterface>
            <errorLevel type="suppress">
                <referencedClass name="Doctrine\ORM\Query\AST\TypedExpression" />
            </errorLevel>
        </DeprecatedInterface>
        <!-- deprecated in doctrine/collections 3.1, but its replacement
        SortDirection is not available in doctrine/collections 2 -->
        <DeprecatedClass>
            <errorLevel type="suppress">
                <referencedClass name="Doctrine\Common\Collections\Order" />
            </errorLevel>
        </DeprecatedClass>
        <MoreSpecificReturnType>
            <errorLevel type="suppress">
                <file name="packages/analytics-bundle/src/Common/ApplicableDimensionsTrait.php" />
            </errorLevel>
        </MoreSpecificReturnType>
    </issueHandlers>

    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin" />
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin" />
    </plugins>
</psalm>